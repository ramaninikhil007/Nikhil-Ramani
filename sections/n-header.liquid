{{ 'n-header.css' | asset_url | stylesheet_tag }}

<header>
    {% if section.settings.text != blank or section.settings.button_label != blank %}
    <button class="menu-toggle large-up-hide" type="button">
        <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 6H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M1 1H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M1 11H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
    {% endif %}
    
      {%- if request.page_type == 'index' -%}
        <h1 class="header__logo">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__logo">
        {%- if section.settings.logo != blank -%}
          <div class="header__logo-wrapper">
            {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio -%}
            {% capture sizes %}(max-width: {{ section.settings.logo_width | times: 2 }}px) 50vw, {{ section.settings.logo_width }}px{% endcapture %}
            {% capture widths %}{{ section.settings.logo_width }}, {{ section.settings.logo_width | times: 1.5 | round }}, {{ section.settings.logo_width | times: 2 }}{% endcapture %}
            {{
              section.settings.logo
              | image_url: width: 600
              | image_tag:
                widths: widths,
                height: logo_height,
                width: section.settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    
    <div class="header__info-text medium-hide small-hide">{{ section.settings.text }}</div>
    <a href="{{ section.settings.button_link }}" class="btn btn-yellow btn-with-arrow medium-hide small-hide">
        <span>{{ section.settings.button_label }}<svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/></svg></span>
    </a>
</header>

{% if section.settings.text != blank or section.settings.button_label != blank %}
<div id="mobile_menu" class="mobile-menu large-up-hide">
    <div class="mobile-menu-inner">
        {% if section.settings.text != blank %}
        <div class="header__info-text">{{ section.settings.text }}</div>
        {% endif %}
        {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn-yellow btn-with-arrow">
            <span>{{ section.settings.button_label }}<svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/></svg></span>
        </a>
        {% endif %}
    </div>
</div>
{% endif %}

<script>
    var toggle = document.querySelector(".menu-toggle");
    var topNav = document.querySelector(".mobile-menu");


    // Listen for click event on toggle var
    toggle.addEventListener('click', function() {
    console.log("toggle clicked");
    // toggle class "active" on topNav var
    topNav.classList.toggle("open");
    }, false);
</script>

{% schema %}
{
  "name": "N Header",
  "class": "n-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px",
        "label": "Logo width"
      },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}